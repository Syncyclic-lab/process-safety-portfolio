---
import SectionHead from './SectionHead.astro';
import { certifications, education, training } from '../data/resume';
---

<section class="section" id="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <SectionHead num="04" kicker="Licenses, certifications, education" id="credentials-title" title="Credentials" />

    <div class="grid">
      <div class="block panel">
        <h3>Licenses and certifications</h3>
        <ul class="rows">
          {
            certifications.map((c) => (
              <li>
                <span class="name">{c.name}</span>
                <span class="issuer">{c.issuer}</span>
                <span class="year">{c.year}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="stack">
        <div class="block panel">
          <h3>Education</h3>
          <ul class="rows">
            {
              education.map((e) => (
                <li>
                  <span class="name">{e.degree}</span>
                  <span class="issuer">
                    {e.school}
                    {e.note && <span class="note"> · {e.note}</span>}
                  </span>
                  <span class="year">{e.year}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="block panel">
          <h3>Training</h3>
          <ul class="chips">
            {training.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    align-items: start;
  }

  .stack {
    display: grid;
    gap: 14px;
  }

  .block {
    padding: 20px;
  }

  h3 {
    font-size: 1rem;
    margin-bottom: 14px;
  }

  .rows {
    list-style: none;
  }

  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 16px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .rows li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .name {
    font-weight: 500;
  }

  .issuer {
    grid-column: 1;
    font-size: 0.9rem;
    color: var(--text-3);
  }

  .year {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-2);
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .block {
      padding: 16px;
    }
  }
</style>
