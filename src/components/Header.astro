---
import Icon from './Icon.astro';
import { profile } from '../data/resume';
import { url } from '../lib/url';

const sections = [
  { id: 'experience', label: 'Experience' },
  { id: 'capabilities', label: 'Capabilities' },
  { id: 'work', label: 'Selected work' },
  { id: 'credentials', label: 'Credentials' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];

const resumeHref = profile.resumePdf ? url(profile.resumePdf) : url('resume/');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={`${profile.name}, back to top`}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M3 16h26" stroke="currentColor" stroke-width="2"></path>
      </svg>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav aria-label="Sections">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`} data-nav={s.id}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
        <Icon name="moon" class="icon-moon" />
        <Icon name="sun" class="icon-sun" />
      </button>
      <a class="btn btn-primary btn-sm" href={resumeHref}>
        <Icon name={profile.resumePdf ? 'download' : 'file'} />
        Resume
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .mark {
    width: 26px;
    height: 26px;
    color: var(--accent);
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--text-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    background: var(--panel-2);
  }

  nav a[aria-current='true'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  .theme-toggle :global(svg) {
    width: 18px;
    height: 18px;
  }

  /* Show the icon for the theme you would switch to. */
  .theme-toggle :global(.icon-sun) {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-sun) {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-sun) {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-moon) {
      display: none;
    }
  }

  @media (max-width: 960px) {
    nav {
      display: none;
    }

    .actions {
      margin-left: auto;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function isDark() {
    if (root.dataset.theme) return root.dataset.theme === 'dark';
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function label() {
    toggle?.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
  }

  label();
  toggle?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    label();
  });

  // Underline the nav link for the section currently on screen.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-nav]').forEach((a) => links.set(a.dataset.nav!, a));

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a, id) => a.setAttribute('aria-current', id === entry.target.id ? 'true' : 'false'));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );

  links.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  });
</script>
