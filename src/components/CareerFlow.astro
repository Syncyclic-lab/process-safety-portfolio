---
/**
 * Experience drawn as a P&ID: education is the feed, each role is a unit on
 * the process line, and the off-page connector points to the next role.
 *
 * Desktop: the diagram selects which role's detail card is shown.
 * Mobile, print, and no-JS: the diagram is hidden (or inert) and every role
 * is listed newest first along a vertical process line.
 */
import Equipment from './Equipment.astro';
import SectionHead from './SectionHead.astro';
import { roles, education } from '../data/resume';

const slug = (tag: string) => `role-${tag.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const chronological = [...roles].reverse();
const current = roles[0];
const feed = education[0];
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <SectionHead
      num="01"
      kicker="Career flow"
      id="experience-title"
      title="Experience"
      lead="Drawn as a process flow, from education to my current role."
    />

    <div class="flow" data-flow data-initial={slug(current.tag)}>
      <div class="diagram panel">
        <div class="track" style={`--units: ${chronological.length}`}>
          <div class="feed">
            <span class="tag">Feed</span>
            <span class="feed-name">{feed.degree}</span>
            <span class="feed-meta">{feed.schoolShort ?? feed.school} · {feed.year}</span>
          </div>

          <ol class="units">
            {
              chronological.map((r) => (
                <li>
                  <a
                    class="unit"
                    href={`#${slug(r.tag)}`}
                    data-unit={slug(r.tag)}
                    aria-controls={slug(r.tag)}
                    aria-current={r === current ? 'true' : 'false'}
                  >
                    <Equipment type={r.equipment} />
                    <span class="u-tag">{r.tag}</span>
                    <span class="u-title">{r.title}</span>
                    <span class="u-years">
                      {r.start}–{r.end}
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>

          <a class="out" href="#contact">
            <svg viewBox="0 0 58 34" aria-hidden="true" focusable="false">
              <path d="M1 1 H41 L57 17 L41 33 H1 Z"></path>
            </svg>
            <span class="out-label">Contact</span>
            <span class="out-meta">Get in touch</span>
          </a>
        </div>
        <p class="hint">Select a unit to view its details</p>
      </div>

      <div class="details">
        {
          roles.map((r) => (
            <article
              class="role"
              id={slug(r.tag)}
              data-role={slug(r.tag)}
              data-current={r === current ? '' : undefined}
              aria-labelledby={`${slug(r.tag)}-title`}
            >
              <div class="rail" aria-hidden="true">
                <Equipment type={r.equipment} />
              </div>
              <div class="card panel">
                <div class="card-head">
                  <span class="tag">
                    {r.tag} · {r.industry}
                  </span>
                  <span class="tag">
                    {r.start}–{r.end}
                  </span>
                </div>
                <div class="card-body">
                  <div class="intro">
                    <h3 id={`${slug(r.tag)}-title`}>{r.title}</h3>
                    <p class="meta">
                      {r.company} · {r.location}
                    </p>
                    <p class="summary">{r.summary}</p>
                    <ul class="chips" aria-label="Focus areas">
                      {r.focus.map((f) => (
                        <li>{f}</li>
                      ))}
                    </ul>
                  </div>
                  <ul class="highlights">
                    {r.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .flow {
    --sym-w: 80px;
    --sym-h: 120px;
    --track-pad: 28px;
    --out-w: 96px;
  }

  /* ---------- Diagram (desktop) ---------- */

  .diagram {
    padding: 0 clamp(16px, 3vw, 32px) 18px;
  }

  .track {
    position: relative;
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) var(--out-w);
    padding-top: var(--track-pad);
  }

  /*
   * The process line stays solid (dashed lines mean signals on a P&ID). A
   * single soft pulse travels along it toward the current role.
   */
  .track::before,
  .track::after {
    content: '';
    position: absolute;
    left: 0;
    right: var(--out-w);
    top: calc(var(--track-pad) + var(--sym-h) - 1px);
    height: 2px;
  }

  .track::before {
    background: var(--pipe);
  }

  .track::after {
    background: linear-gradient(90deg, transparent, var(--accent), transparent) no-repeat;
    background-size: 140px 100%;
    background-position: -140px 0;
    animation: flow 5s linear infinite;
  }

  @keyframes flow {
    from {
      background-position: -140px 0;
    }
    to {
      background-position: calc(100% + 140px) 0;
    }
  }

  /* Arrowheads on the line at the end of the feed and after each unit. */
  .feed::after,
  .units li::after {
    content: '';
    position: absolute;
    right: -1px;
    top: calc(var(--sym-h) - 6px);
    border-left: 10px solid var(--pipe);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    z-index: 1;
  }

  .feed {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2px;
    height: calc(var(--sym-h) - 10px);
    padding-right: 20px;
  }

  .feed-name {
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .feed-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .units {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--units), minmax(0, 1fr));
  }

  .units li {
    position: relative;
  }

  .unit {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 10px 16px;
    text-decoration: none;
    color: var(--text-2);
    border-radius: var(--radius);
  }

  .unit :global(.equip) {
    width: var(--sym-w);
    height: var(--sym-h);
    color: var(--text-3);
    transition: color 150ms ease;
  }

  .unit:hover :global(.equip) {
    color: var(--text);
  }

  .u-tag {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-3);
  }

  .u-title {
    margin-top: 4px;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
  }

  .u-years {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .unit[aria-current='true'] :global(.equip),
  .unit[aria-current='true'] .u-tag {
    color: var(--accent);
  }

  .unit[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 32%;
    right: 32%;
    bottom: 0;
    height: 2px;
    background: var(--accent);
  }

  /* Off-page connector: where the line leaves this drawing. */
  .out {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: calc(var(--sym-h) - 17px);
    text-decoration: none;
    color: var(--text-3);
  }

  .out svg {
    width: 58px;
    height: 34px;
  }

  .out path {
    fill: var(--panel);
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .out:hover {
    color: var(--accent);
  }

  .out-label {
    margin-top: 14px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
  }

  .out-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .hint {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
    text-align: center;
  }

  /* ---------- Detail cards ---------- */

  .details {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }

  .rail {
    display: none;
  }

  .card {
    overflow: hidden;
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 11px 22px;
    background: var(--panel-2);
    border-bottom: 1px solid var(--line);
  }

  .card-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 20px 40px;
    padding: 22px;
  }

  .meta {
    margin-top: 6px;
    color: var(--text-2);
  }

  .summary {
    margin-top: 14px;
    color: var(--text-2);
  }

  .chips {
    margin-top: 16px;
  }

  .highlights {
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .highlights li {
    position: relative;
    padding-left: 20px;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    background: var(--line-strong);
  }

  @media (min-width: 901px) {
    .flow.is-enhanced .role:not(.is-active) {
      display: none;
    }
  }

  /* ---------- Mobile: vertical process line ---------- */

  @media (max-width: 900px) {
    .diagram {
      display: none;
    }

    .details {
      position: relative;
      gap: 20px;
      margin-top: 0;
    }

    .details::before {
      content: '';
      position: absolute;
      left: 23px;
      top: 20px;
      bottom: 20px;
      width: 2px;
      background: var(--pipe);
    }

    .role {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
    }

    .rail {
      display: block;
      position: relative;
      padding-top: 8px;
    }

    .rail :global(.equip) {
      width: 48px;
      height: 72px;
      color: var(--text-3);
    }

    .role[data-current] .rail :global(.equip) {
      color: var(--accent);
    }

    .card-head {
      padding: 10px 16px;
    }

    .card-body {
      grid-template-columns: minmax(0, 1fr);
      padding: 16px;
    }
  }

  @media print {
    .diagram {
      display: none;
    }

    .role {
      display: block !important;
      break-inside: avoid;
    }
  }
</style>

<script>
  const flow = document.querySelector<HTMLElement>('[data-flow]');

  if (flow) {
    const units = Array.from(flow.querySelectorAll<HTMLAnchorElement>('[data-unit]'));
    const roles = Array.from(flow.querySelectorAll<HTMLElement>('[data-role]'));
    const desktop = window.matchMedia('(min-width: 901px)');

    const select = (id: string) => {
      units.forEach((u) => u.setAttribute('aria-current', String(u.dataset.unit === id)));
      roles.forEach((r) => r.classList.toggle('is-active', r.dataset.role === id));
    };

    units.forEach((u) =>
      u.addEventListener('click', (event) => {
        if (!desktop.matches) return;
        event.preventDefault();
        select(u.dataset.unit!);
      }),
    );

    // A link straight to a role (e.g. #role-c-301) opens that role.
    const roleFromHash = () => roles.find((r) => `#${r.id}` === location.hash)?.dataset.role;
    window.addEventListener('hashchange', () => {
      const id = roleFromHash();
      if (id) select(id);
    });

    select(roleFromHash() ?? flow.dataset.initial!);
    flow.classList.add('is-enhanced');
  }
</script>
