---
/**
 * Print-ready resume generated from the same data as the site. Recruiters can
 * print it or save it as PDF; it is also the fallback until a PDF is added.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile, roles, capabilities, certifications, education, training, dataSheet } from '../data/resume';
import { url } from '../lib/url';

const linkedinDisplay = profile.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title={`${profile.name} | Resume`} description={`Resume of ${profile.name}, ${profile.headline}.`}>
  <div class="toolbar no-print">
    <a class="btn btn-sm" href={url()}>
      <Icon name="arrow-left" />
      Back to site
    </a>
    <button class="btn btn-primary btn-sm" type="button" data-print>
      <Icon name="printer" />
      Print or save as PDF
    </button>
  </div>

  <main class="paper">
    <header class="masthead">
      <h1>{profile.name}{profile.postNominals && `, ${profile.postNominals}`}</h1>
      <p class="role">{profile.headline}</p>
      <p class="contact">
        <span>{profile.location}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span>{profile.phone}</span>
        <a href={profile.linkedin}>{linkedinDisplay}</a>
      </p>
    </header>

    <section>
      <h2>Summary</h2>
      <p>{dataSheet.profile}</p>
    </section>

    <section>
      <h2>Experience</h2>
      {
        roles.map((r) => (
          <article class="job">
            <div class="job-head">
              <h3>{r.title}</h3>
              <span class="dates">
                {r.start} – {r.end}
              </span>
            </div>
            <p class="org">
              {r.company} · {r.location}
            </p>
            <ul>
              {r.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {
          capabilities.map((c) => (
            <div>
              <dt>{c.title}</dt>
              <dd>{c.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="two-col">
      <section>
        <h2>Licenses and certifications</h2>
        <ul class="plain">
          {
            certifications.map((c) => (
              <li>
                <strong>{c.name}</strong>, {c.issuer}, {c.year}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        <ul class="plain">
          {
            education.map((e) => (
              <li>
                <strong>{e.degree}</strong>, {e.school}, {e.year}
              </li>
            ))
          }
        </ul>
        <h2 class="sub">Training</h2>
        <p>{training.join(' · ')}</p>
      </section>
    </div>
  </main>
</Base>

<style>
  /* The resume is always "paper": fixed ink colors regardless of site theme. */
  .toolbar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    max-width: calc(8.5in + 32px);
    margin: 0 auto;
    padding: 20px 16px 16px;
  }

  .paper {
    --ink: #111418;
    --ink-2: #3b424a;
    --rule: #c9ced4;
    max-width: 8.5in;
    margin: 0 auto 48px;
    padding: 0.6in 0.65in;
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--line);
    font-size: 10.5pt;
    line-height: 1.45;
  }

  .masthead {
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
  }

  h1 {
    font-size: 22pt;
    letter-spacing: -0.01em;
  }

  .role {
    margin-top: 2px;
    font-size: 12pt;
    font-weight: 500;
    color: var(--ink-2);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    margin-top: 8px;
    font-size: 9.5pt;
    color: var(--ink-2);
  }

  .contact a {
    color: inherit;
    text-decoration: none;
  }

  section {
    margin-top: 16px;
  }

  h2 {
    font-size: 10pt;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-bottom: 4px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--rule);
  }

  h2.sub {
    margin-top: 12px;
  }

  .job + .job {
    margin-top: 12px;
  }

  .job {
    break-inside: avoid;
  }

  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  h3 {
    font-size: 11pt;
  }

  .dates {
    font-family: var(--font-mono);
    font-size: 9pt;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .org {
    color: var(--ink-2);
  }

  .job ul {
    margin-top: 4px;
    padding-left: 18px;
  }

  .job li + li {
    margin-top: 2px;
  }

  .skills {
    display: grid;
    gap: 4px;
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 1.6in minmax(0, 1fr);
    gap: 12px;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
  }

  .plain {
    list-style: none;
    display: grid;
    gap: 4px;
  }

  .plain strong {
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .paper {
      padding: 24px 18px;
      border-inline: 0;
    }

    .skills div,
    .two-col {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media print {
    @page {
      size: letter;
      margin: 0.5in 0.55in;
    }

    .paper {
      max-width: none;
      margin: 0;
      padding: 0;
      border: 0;
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
